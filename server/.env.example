PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
JWT_SECRET=
JWT_EXPIRES_IN=7d
# Gmail OAuth configuration (server-side only)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/integrations/gmail/oauth/callback
# A dedicated random secret for encrypting Gmail access and refresh tokens.
GMAIL_TOKEN_ENCRYPTION_KEY=
# Google Gemini configuration (server-side only). GEMINI_MODEL is optional.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
SERVER_URL=http://localhost:5000
